# ─────────────────────────────────────────────────────────────────────────────
# ШАБЛОН секретов агента. На сервере → ~/.hermes/.env, chmod 600. НЕ коммитить.
# Фактически развёрнуто на Google Gemini (OpenAI-совместимый эндпоинт).
# ─────────────────────────────────────────────────────────────────────────────

# LLM: Google Gemini (AI Studio, без карты). Ключ: https://aistudio.google.com/apikey
OPENAI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Telegram-шлюз
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ALLOWED_USERS=123456789     # только свой numeric id; "allow all" НЕ включать
