# ─────────────────────────────────────────────────────────────────────────────
# ШАБЛОН секретов агента.  На сервере скопировать в ~/.hermes/.env и заполнить.
# Реальный .env НИКОГДА не коммитится (см. .gitignore).  Все значения — примеры.
#
#   cp deploy/.env.example ~/.hermes/.env
#   chmod 600 ~/.hermes/.env
# ─────────────────────────────────────────────────────────────────────────────

# === LLM: OpenRouter (агрегатор, OpenAI-совместимый API) ======================
# Ключ: https://openrouter.ai/keys  →  начинается на sk-or-v1-...
# Хранить ТОЛЬКО здесь; при случайной публикации — немедленно отозвать в кабинете.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Telegram-шлюз ============================================================
# Токен бота: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# СВОЙ числовой user id (узнать у @Getmyid_Work_Bot / @userinfobot).
# Разрешаем ТОЛЬКО свой id. Несколько — через запятую. "allow all" НЕ включать.
TELEGRAM_ALLOWED_USERS=123456789

# === Дашборд / API-сервер (наблюдаемость, T4) ================================
# Ключ доступа к локальному API, минимум 8 символов (openssl rand -hex 32).
API_SERVER_KEY=change-me-openssl-rand-hex-32
